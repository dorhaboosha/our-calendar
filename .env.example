# Copy to .env and fill in real values (Prisma and the tests read .env only).
# Never commit the real file; it is git-ignored.
# Non-secret settings (locale, direction, timezone, user names, colors) live in
# src/config/app.config.ts, not here.

# ---- App ----
# Public base URL of the app (the Render URL in production). Read by Better Auth.
BETTER_AUTH_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Local development: Postgres in Docker (npm run db:up, host port 5436) - both URLs are the same.
# Production (Neon): DATABASE_URL = pooled string (host contains "-pooler"),
#                    DIRECT_URL   = direct string (used by Prisma migrations).
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/our_calendar
DIRECT_URL=postgresql://postgres:postgres@localhost:5436/our_calendar
# Integration tests only: separate database, created by docker/init-test-db.sql
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/our_calendar_test

# ---- Authentication / sessions ----
# Signs session cookies. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me
# Google email of each allowed user: USER_EMAIL_<user key from app.config.ts, upper case>.
# Only these two accounts can sign in.
USER_EMAIL_DOR=dor@example.com
USER_EMAIL_MAAYAN=maayan@example.com

# ---- Google OAuth (sign-in + Calendar export) ----
# From Google Cloud Console > Google Auth Platform > Clients (type "Web application").
# Redirect URIs to register there (Authorized redirect URIs), for each environment:
#   sign-in:          <BETTER_AUTH_URL>/api/auth/callback/google
#   Calendar export:  <BETTER_AUTH_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Calendar export connection: the second URI above, exactly as registered.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ---- Export job queue ----
# Shared secret the periodic trigger (.github/workflows/export-jobs.yml) sends to
# POST /api/jobs/run. At least 32 characters; the same value as the CRON_SECRET
# repository secret on GitHub. Generate it like BETTER_AUTH_SECRET above.
CRON_SECRET=replace-me

# ---- Encryption of export refresh tokens at rest ----
# 32-byte key, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes the stored tokens unreadable: each user then has to connect again.
TOKEN_ENCRYPTION_KEY=replace-me

# ---- Backups (optional, local only) ----
# For npm run db:backup: the production DIRECT_URL (Neon, not pooled). See docs/operations.md.
BACKUP_DATABASE_URL=

# Copy to .env.local (or .env) and fill in real values. Never commit the real file.
# Variable names assume the stack proposed in the spec (Next.js + PostgreSQL + Prisma)
# and may change after Phase 0 (Discovery).

# ---- App ----
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jerusalem

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/our_calendar

# ---- Authentication / sessions ----
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=replace-me
# Comma-separated Google emails allowed to sign in (the two users)
ALLOWED_EMAILS=user-a@example.com,user-b@example.com

# ---- Google OAuth / Calendar API ----
# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type "Web application")
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Public HTTPS URL Google sends push notifications to (not usable on plain localhost)
GOOGLE_WEBHOOK_URL=
# Random secret used as the channel token to verify incoming notifications
GOOGLE_WEBHOOK_TOKEN=replace-me

# ---- Encryption of refresh tokens at rest ----
# 32-byte key, base64-encoded, e.g. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=replace-me

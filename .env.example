# Copy to .env.local (or .env) and fill in real values. Never commit the real file.
# Non-secret settings (locale, direction, timezone, user names, colors) live in
# src/config/app.config.ts, not here.

# ---- App ----
# Public base URL of the app (the Render URL in production). Read by Better Auth.
BETTER_AUTH_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Local development: Postgres in Docker (npm run db:up, host port 5436) - both URLs are the same.
# Production (Neon): DATABASE_URL = pooled string (host contains "-pooler"),
#                    DIRECT_URL   = direct string (used by Prisma migrations).
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/our_calendar
DIRECT_URL=postgresql://postgres:postgres@localhost:5436/our_calendar
# Integration tests only: separate database, created by docker/init-test-db.sql
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/our_calendar_test

# ---- Authentication / sessions ----
# Signs session cookies. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me
# Google email of each allowed user: USER_EMAIL_<user key from app.config.ts, upper case>.
# Only these two accounts can sign in.
USER_EMAIL_DOR=dor@example.com
USER_EMAIL_MAAYAN=maayan@example.com

# ---- Google OAuth (sign-in + Calendar export) ----
# From Google Cloud Console > Google Auth Platform > Clients (type "Web application").
# Sign-in redirect URI to register there: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ---- Export job queue ----
# Shared secret the periodic trigger sends to the endpoint that retries failed export jobs
CRON_SECRET=replace-me

# ---- Encryption of refresh tokens at rest ----
# 32-byte key, base64-encoded, e.g. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=replace-me

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Users & authentication ----
// User, Session, Account and Verification are the core tables Better Auth expects.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Which user from app.config.ts this is ("dor" / "maayan").
  configKey     String    @unique
  /// Color the user picked in settings; null means the config default.
  color         String?
  sessions      Session[]
  accounts      Account[]
  ownedEvents   Event[]   @relation("EventOwner")
  createdEvents Event[]   @relation("EventCreatedBy")
  updatedEvents Event[]   @relation("EventUpdatedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- Calendar ----

enum EventOwnerType {
  /// Personal event of ownerUserId.
  USER
  /// Shared event of both users (ownerUserId is null).
  SHARED
}

/// One calendar event. Timed events use startAt/endAt; all-day events use
/// startDate/endDate. Exactly one pair is set, enforced by CHECK constraints in the
/// migration (Prisma can't express them).
model Event {
  id              String         @id @default(uuid())
  title           String
  description     String?
  location        String?
  ownerType       EventOwnerType
  ownerUserId     String?
  owner           User?          @relation("EventOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// Category key from app.config.ts. Not a database enum, so categories can change
  /// without a migration; the app validates the key.
  category        String
  isAllDay        Boolean
  /// Timed events: the exact start and end instants.
  startAt         DateTime?      @db.Timestamptz(3)
  endAt           DateTime?      @db.Timestamptz(3)
  /// All-day events: dates with no time. endDate is EXCLUSIVE (the day after the last
  /// day), like Google Calendar; the form shows the last day itself.
  startDate       DateTime?      @db.Date
  endDate         DateTime?      @db.Date
  /// IANA time zone the event's local times belong to.
  timezone        String         @default("Asia/Jerusalem")
  createdByUserId String
  createdBy       User           @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String
  updatedBy       User           @relation("EventUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Soft delete: kept so the Google export (Phase 4) can delete the exported copy.
  deletedAt       DateTime?
  /// Goes up by one on every change; the export uses it to skip unchanged events.
  version         Int            @default(1)

  @@index([startAt, endAt])
  @@index([startDate, endDate])
  @@index([ownerUserId])
  @@map("event")
}

// ---- Settings shared by both users ----

/// A single row (id 1, enforced by a CHECK constraint) of settings that belong to both
/// users rather than to one of them.
model SharedSettings {
  id          Int      @id @default(1)
  /// Color of shared events; null means the config default.
  sharedColor String?
  updatedAt   DateTime @updatedAt

  @@map("shared_settings")
}
